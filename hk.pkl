amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"

local linters  = new Mapping<String, Step> {
  ["dprint"]  {
    fix = "dprint fmt"
    stage = "*"
  }
  ["clippy"] {
    check = "cargo clippy -- -D warnings"
  }
  ["fmt"] {
    check = "cargo fmt -- --check"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters

  }
}
